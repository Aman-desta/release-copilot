    "EvidenceGap": {
      "additionalProperties": false,
      "description": "A piece of evidence that is missing, and why. Gaps are facts too: \"coverage unknown\" must reach the report.",
      "properties": {
        "error_type": {
          "description": "Integration error type, UnexpectedResponse, or Blocked.",
          "type": "string"
        },
        "kind": {
          "description": "unavailable: the source failed \u00b7 missing: the source has no such data \u00b7 blocked: not attempted because evidence it depends on is missing.",
          "enum": [
            "unavailable",
            "missing",
            "blocked"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
