    "ReleaseIdentity": {
      "additionalProperties": false,
      "description": "Which release this is, and the naming conventions that turn it into refs, versions and keys.\n\nThe conventions live here only, so a team with other branch names changes one class, not every worker.",
      "properties": {
        "previous_version": {
          "description": "The release running in production now, e.g. 2.3.1. The diff baseline.",
          "type": "string"
        },
        "service": {
          "description": "Service name as registered in the CMDB, e.g. payments-api.",
          "type": "string"
        },
        "version": {
          "description": "The release being prepared, e.g. 2.4.0.",
          "type": "string"
        }
      },
      "required": [
        "service",
        "version",
        "previous_version"
      ],
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "reviewer": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "submitted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "reviewer",
        "state"
      ],
      "type": "object"
    },
    "ReviewedPull": {
      "additionalProperties": false,
      "properties": {
        "pull": {
          "$ref": "#/$defs/PullRequest"
        },
        "reviews": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Review"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pull",
        "reviews"
      ],
      "type": "object"
    },
    "ServiceSection": {
      "additionalProperties": false,
      "description": "ServiceNow context: how critical the service is, who supports it, and how past changes went.",
      "properties": {
        "ci": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfigurationItem"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "existing_change": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recent_changes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ChangeRequest"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_group": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnowGroup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "SnowGroup": {
      "additionalProperties": false,
      "properties": {
        "manager_sys_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "sys_id": {
          "type": "string"
        },
        "type": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "sys_id",
        "name"
      ],
      "type": "object"
    },
    "TicketSection": {
      "additionalProperties": false,
      "description": "Jira worker: release scope and ticket hygiene.",
      "properties": {
        "issues": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Issue"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "All evidence for one release. Deterministic for the same upstream state, except ``collected_at``.",
  "properties": {
    "change": {
      "$ref": "#/$defs/ChangeSection",
      "default": {
        "commit_reviews": null,
        "comparison": null
      }
    },
    "collected_at": {
      "format": "date-time",
      "type": "string"
    },
    "deploy": {
      "$ref": "#/$defs/DeploySection",
      "default": {
        "deployments": null,
        "metrics": null,
        "slots": null
      }
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceGap"
      },
      "type": "array"
    },
    "identity": {
      "$ref": "#/$defs/ReleaseIdentity"
    },
    "quality": {
      "$ref": "#/$defs/QualitySection",
      "default": {
        "checks": null,
        "code_scanning_alerts": null,
        "dependency_alerts": null,
        "gate": null,
        "measures": null,
        "previous_measures": null
      }
    },
    "service": {
      "$ref": "#/$defs/ServiceSection",
      "default": {
        "ci": null,
        "existing_change": null,
        "recent_changes": null,
        "support_group": null
      }
    },
    "tickets": {
      "$ref": "#/$defs/TicketSection",
      "default": {
        "issues": null
      }
    }
  },
  "required": [
    "identity",
    "collected_at"
  ],
  "type": "object"
}
