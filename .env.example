# Mock enterprise services (python -m release_copilot.mocks). All values below are test values.
RELEASE_COPILOT_MOCK_PORT=9100
RELEASE_COPILOT_MOCK_DEFAULT_SCENARIO=clean
RELEASE_COPILOT_MOCK_AUTH_ENABLED=true

RELEASE_COPILOT_MOCK_JIRA_EMAIL=release-bot@acme-fin.test
RELEASE_COPILOT_MOCK_JIRA_API_TOKEN=jira-test-token
RELEASE_COPILOT_MOCK_GITHUB_TOKEN=ghp_testtoken000000000000000000000000
RELEASE_COPILOT_MOCK_AZURE_TENANT_ID=11111111-1111-4111-8111-111111111111
RELEASE_COPILOT_MOCK_AZURE_CLIENT_ID=22222222-2222-4222-8222-222222222222
RELEASE_COPILOT_MOCK_AZURE_CLIENT_SECRET=azure-test-secret
# Set low (e.g. 60) to practise token refresh in the Azure client.
RELEASE_COPILOT_MOCK_AZURE_TOKEN_TTL_SECONDS=3600
RELEASE_COPILOT_MOCK_SONAR_TOKEN=squ_testtoken
RELEASE_COPILOT_MOCK_SERVICENOW_USER=release.copilot
RELEASE_COPILOT_MOCK_SERVICENOW_PASSWORD=snow-test-password
