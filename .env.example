# Copy to .env. Local development values only; never commit .env.

# ---- Docker Compose (compose.yaml) -------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
RELEASE_COPILOT_DB_NAME=release_copilot
RELEASE_COPILOT_DB_APP_USER=copilot_app
RELEASE_COPILOT_DB_APP_PASSWORD=change-me-app
RELEASE_COPILOT_DB_SCHEMA=copilot
RELEASE_COPILOT_DB_PORT=5432
RELEASE_COPILOT_MOCKS_PORT=9100

# ---- Application settings (release_copilot/config.py) ------------------------------------------
RELEASE_COPILOT_ENV=local
# The app connects as the least-privilege role, never as postgres.
RELEASE_COPILOT_DATABASE_URL=postgresql+psycopg://copilot_app:change-me-app@localhost:5432/release_copilot
# Optional: database tests run only when this is set (point it at a disposable database).
# RELEASE_COPILOT_TEST_DATABASE_URL=postgresql+psycopg://copilot_app:change-me-app@localhost:5432/release_copilot

# Enterprise systems (these values point at release-copilot-mocks; real services only change URLs and secrets).
RELEASE_COPILOT_JIRA__BASE_URL=http://localhost:9100/jira
RELEASE_COPILOT_JIRA__EMAIL=release-bot@acme-fin.test
RELEASE_COPILOT_JIRA__API_TOKEN=jira-test-token
RELEASE_COPILOT_JIRA__PROJECT_KEY=PAY

RELEASE_COPILOT_GITHUB__BASE_URL=http://localhost:9100/github
RELEASE_COPILOT_GITHUB__TOKEN=ghp_testtoken000000000000000000000000
RELEASE_COPILOT_GITHUB__OWNER=acme-fin
RELEASE_COPILOT_GITHUB__REPO=payments-api

RELEASE_COPILOT_AZURE__AUTHORITY_URL=http://localhost:9100/azure/login
RELEASE_COPILOT_AZURE__MANAGEMENT_URL=http://localhost:9100/azure/management
RELEASE_COPILOT_AZURE__TENANT_ID=11111111-1111-4111-8111-111111111111
RELEASE_COPILOT_AZURE__CLIENT_ID=22222222-2222-4222-8222-222222222222
RELEASE_COPILOT_AZURE__CLIENT_SECRET=azure-test-secret
RELEASE_COPILOT_AZURE__SUBSCRIPTION_ID=6f1c2a9e-3b4d-4e5f-8a7b-0c1d2e3f4a5b
RELEASE_COPILOT_AZURE__RESOURCE_GROUP=rg-payments-prod
RELEASE_COPILOT_AZURE__SITE=app-payments-api-prod

RELEASE_COPILOT_SONAR__BASE_URL=http://localhost:9100/sonar
RELEASE_COPILOT_SONAR__TOKEN=squ_testtoken
RELEASE_COPILOT_SONAR__PROJECT_KEY=payments-api

RELEASE_COPILOT_SERVICENOW__BASE_URL=http://localhost:9100/servicenow
RELEASE_COPILOT_SERVICENOW__USER=release.copilot
RELEASE_COPILOT_SERVICENOW__PASSWORD=snow-test-password

RELEASE_COPILOT_NOTIFY__TEAMS_WEBHOOK_URL=http://localhost:9100/notify/teams/release-approvals
RELEASE_COPILOT_NOTIFY__SLACK_WEBHOOK_URL=http://localhost:9100/notify/slack/payments-releases
