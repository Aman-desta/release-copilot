{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Mocks: enterprise services (:9100)",
            "type": "debugpy",
            "request": "launch",
            "module": "release_copilot.mocks",
            "args": ["--scenario", "${input:scenario}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Tests: debug all",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ],
    "inputs": [
        {
            "id": "scenario",
            "type": "pickString",
            "description": "Default mock scenario",
            "options": ["clean", "critical_cve", "coverage_drop", "failed_deploy", "prompt_injection", "pii_in_ticket"],
            "default": "clean"
        }
    ]
}
